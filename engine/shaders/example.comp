#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) buffer InputBuffer {
    float data[];
} inputBuf;

layout(binding = 1) buffer OutputBuffer {
    float data[];
} outputBuf;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    outputBuf.data[idx] = inputBuf.data[idx] * 2.0;
}
